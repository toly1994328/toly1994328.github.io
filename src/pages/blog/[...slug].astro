---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

const post = Astro.props;
const { Content, headings } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="post-layout">
    <!-- 左侧正文 -->
    <article class="post animate-in">
      <header class="post-header">
        <div class="post-meta">
          <a href={`/categories/${post.data.category}`} class="post-category">{post.data.category}</a>
          <time>{post.data.date.toLocaleDateString('zh-CN')}</time>
        </div>
        <h1 class="post-title">{post.data.title}</h1>
        <p class="post-desc">{post.data.description}</p>
        <div class="post-tags">
          {post.data.tags.map(tag => (
            <a href={`/tags/${tag}`} class="tag">#{tag}</a>
          ))}
        </div>
      </header>

      <div class="post-content">
        <Content />
      </div>
    </article>

    <!-- 右侧大纲 -->
    <aside class="toc-sidebar">
      <div class="toc-inner">
        <h3 class="toc-title">目录</h3>
        <nav class="toc-nav">
          {headings.map(h => (
            <a href={`#${h.slug}`} class={`toc-link toc-level-${h.depth}`} data-slug={h.slug}>
              {h.text}
            </a>
          ))}
        </nav>
      </div>
    </aside>
  </div>

  <script>
    // TOC active state on scroll
    const tocLinks = document.querySelectorAll('.toc-link');
    const headings = document.querySelectorAll('.post-content h2, .post-content h3, .post-content h4, .post-content h5');

    function updateToc() {
      let current = '';
      headings.forEach(h => {
        const top = h.getBoundingClientRect().top;
        if (top < 120) current = h.id;
      });
      tocLinks.forEach(link => {
        link.classList.toggle('active', link.getAttribute('data-slug') === current);
      });
    }

    window.addEventListener('scroll', updateToc, { passive: true });
    updateToc();
  </script>
</BaseLayout>

<style>
  .post-layout {
    display: flex;
    gap: 2rem;
    max-width: 100%;
  }

  /* TOC Sidebar */
  .toc-sidebar {
    position: sticky;
    top: 2rem;
    width: 220px;
    height: calc(100vh - 4rem);
    flex-shrink: 0;
    overflow-y: auto;
    display: none;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 0, 0, 0.15) transparent;
  }

  .toc-sidebar::-webkit-scrollbar {
    width: 4px;
  }

  .toc-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-sidebar::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 4px;
  }

  .toc-sidebar::-webkit-scrollbar-thumb:hover {
    background: var(--accent);
  }

  @media (min-width: 1100px) {
    .toc-sidebar {
      display: block;
    }
  }

  .toc-inner {
    padding: 1rem 0;
  }

  .toc-title {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
    padding-left: 0.75rem;
  }

  .toc-nav {
    display: flex;
    flex-direction: column;
  }

  .toc-link {
    display: block;
    padding: 0.3rem 0.75rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    border-left: 2px solid transparent;
    transition: all 0.2s;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .toc-link:hover {
    color: var(--text);
    border-left-color: var(--border);
  }

  .toc-link.active {
    color: var(--accent-light);
    border-left-color: var(--accent);
    font-weight: 500;
  }

  .toc-level-3 {
    padding-left: 1.5rem;
    font-size: 0.75rem;
  }

  .toc-level-4 {
    padding-left: 2.25rem;
    font-size: 0.72rem;
  }

  .toc-level-5 {
    padding-left: 3rem;
    font-size: 0.7rem;
  }

  /* Article */
  .post {
    flex: 1;
    min-width: 0;
  }

  .post-header {
    padding: 2rem 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .post-category {
    background: linear-gradient(135deg, var(--gradient-start), var(--gradient-end));
    color: white;
    padding: 0.2rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .post-title {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    font-weight: 800;
    line-height: 1.3;
    margin-bottom: 0.5rem;
  }

  .post-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.8rem;
    color: var(--accent-light);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }

  .post-content {
    font-size: 0.92rem;
    line-height: 1.8;
  }

  .post-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
  }

  .post-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 2rem 0 0.75rem;
  }

  .post-content :global(h4) {
    font-size: 1.15rem;
    font-weight: 700;
    margin: 1.5rem 0 0.5rem;
  }

  .post-content :global(h5) {
    font-size: 1.05rem;
    font-weight: 600;
    margin: 1.25rem 0 0.5rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(code) {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.9em;
  }

  .post-content :global(pre) {
    background: #1e1e2e !important;
    padding: 1.5rem;
    border-radius: 12px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .post-content :global(pre:has(.mermaid)) {
    background: transparent !important;
    padding: 0;
    border: none;
  }

  .post-content :global(.mermaid) {
    background: transparent !important;
    margin: 1.5rem 0;
    text-align: center;
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--border);
  }

  .post-content :global(.mermaid-wrapper) {
    position: relative;
    margin: 1.5rem 0;
  }

  .post-content :global(.mermaid-wrapper .mermaid) {
    margin: 0;
  }

  .post-content :global(.mermaid-toolbar) {
    position: absolute;
    top: 8px;
    right: 8px;
    display: flex;
    gap: 4px;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .post-content :global(.mermaid-wrapper:hover .mermaid-toolbar) {
    opacity: 1;
  }

  .post-content :global(.mermaid-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    backdrop-filter: blur(8px);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s;
  }

  .post-content :global(.mermaid-btn:hover) {
    color: var(--accent-light);
    border-color: var(--accent);
    box-shadow: 0 2px 8px var(--accent-glow);
  }

  .post-content :global(.mermaid svg) {
    max-width: 100%;
    height: auto;
    background: transparent !important;
  }

  .post-content :global(.mermaid rect.er),
  .post-content :global(.mermaid .background),
  .post-content :global(.mermaid [id*="Background"]) {
    fill: transparent !important;
  }

  .post-content :global(div:has(> .mermaid)) {
    background: transparent !important;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    background: color-mix(in srgb, var(--accent) 5%, transparent);
    border-radius: 0 8px 8px 0;
  }

  .post-content :global(ul), .post-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(hr) {
    border: none;
    height: 1px;
    margin: 3rem auto;
    max-width: 60%;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.5;
  }

  .post-content :global(strong) {
    color: var(--accent-light);
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.6rem 1rem;
    border: 1px solid var(--border);
    text-align: left;
  }

  .post-content :global(th) {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-weight: 700;
  }
</style>
