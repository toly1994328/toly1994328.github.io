---
interface Props {
  title?: string;
  description?: string;
}

const { title = '学海无涯', description = '记录学习与成长的技术博客' } = Astro.props;
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | 学海无涯</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;700;900&family=Orbitron:wght@700;900&display=swap" rel="stylesheet" />
  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
    mermaid.initialize({ 
      startOnLoad: true, 
      theme: 'base',
      themeVariables: {
        background: 'transparent',
        mainBkg: '#f4f0ff',
        primaryColor: '#e8e0ff',
        primaryTextColor: '#333',
        primaryBorderColor: '#6366f1',
        lineColor: '#6366f1',
        secondaryColor: '#f0e8ff',
        tertiaryColor: '#faf8ff',
      }
    });

    // Wait for mermaid to finish rendering, then add toolbar buttons
    setTimeout(() => {
      document.querySelectorAll('.mermaid[data-processed="true"], .mermaid svg').forEach(el => {
        const mermaidEl = el.closest('.mermaid') || el;
        if (mermaidEl.closest('.mermaid-wrapper')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'mermaid-wrapper';
        mermaidEl.parentNode.insertBefore(wrapper, mermaidEl);
        wrapper.appendChild(mermaidEl);

        const toolbar = document.createElement('div');
        toolbar.className = 'mermaid-toolbar';
        toolbar.innerHTML = `
          <button class="mermaid-btn mermaid-fullscreen" title="全屏查看">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>
          </button>
          <button class="mermaid-btn mermaid-download" title="下载图片">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          </button>
        `;
        wrapper.appendChild(toolbar);

        toolbar.querySelector('.mermaid-fullscreen').addEventListener('click', () => {
          const svg = mermaidEl.querySelector('svg');
          if (!svg) return;
          const overlay = document.createElement('div');
          overlay.className = 'mermaid-overlay';
          overlay.innerHTML = `
            <div class="mermaid-overlay-content">
              <div class="mermaid-overlay-toolbar">
                <button class="mermaid-overlay-btn mermaid-zoom-in" title="放大"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg></button>
                <button class="mermaid-overlay-btn mermaid-zoom-out" title="缩小"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg></button>
                <button class="mermaid-overlay-btn mermaid-zoom-reset" title="重置"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg></button>
                <button class="mermaid-overlay-btn mermaid-overlay-close" title="关闭"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
              </div>
              <div class="mermaid-overlay-svg-wrap">${svg.outerHTML}</div>
            </div>
          `;
          document.body.appendChild(overlay);
          let scale = 1;
          const svgWrap = overlay.querySelector('.mermaid-overlay-svg-wrap');
          const applyZoom = () => { svgWrap.style.transform = `scale(${scale})`; };
          overlay.querySelector('.mermaid-zoom-in').addEventListener('click', () => { scale = Math.min(scale + 0.25, 5); applyZoom(); });
          overlay.querySelector('.mermaid-zoom-out').addEventListener('click', () => { scale = Math.max(scale - 0.25, 0.25); applyZoom(); });
          overlay.querySelector('.mermaid-zoom-reset').addEventListener('click', () => { scale = 1; applyZoom(); });
          overlay.querySelector('.mermaid-overlay-content').addEventListener('wheel', (e) => { e.preventDefault(); scale = e.deltaY < 0 ? Math.min(scale + 0.1, 5) : Math.max(scale - 0.1, 0.25); applyZoom(); });
          overlay.addEventListener('click', (e) => { if (e.target === overlay || e.target.closest('.mermaid-overlay-close')) overlay.remove(); });
        });

        toolbar.querySelector('.mermaid-download').addEventListener('click', () => {
          const svg = mermaidEl.querySelector('svg');
          if (!svg) return;
          const svgClone = svg.cloneNode(true);
          svgClone.setAttribute('xmlns', 'http://www.w3.org/2000/svg');
          const bbox = svg.getBBox();
          const viewBox = svg.getAttribute('viewBox');
          if (!viewBox) svgClone.setAttribute('viewBox', `${bbox.x} ${bbox.y} ${bbox.width} ${bbox.height}`);
          const vb = (svgClone.getAttribute('viewBox') || '').split(/\s+/);
          const w = parseFloat(vb[2]) || svg.clientWidth || 800;
          const h = parseFloat(vb[3]) || svg.clientHeight || 600;
          svgClone.setAttribute('width', String(w));
          svgClone.setAttribute('height', String(h));
          svg.querySelectorAll('style').forEach(s => svgClone.insertBefore(s.cloneNode(true), svgClone.firstChild));
          const svgData = new XMLSerializer().serializeToString(svgClone);
          const img = new Image();
          img.onload = () => {
            const s = 2, canvas = document.createElement('canvas');
            canvas.width = w * s; canvas.height = h * s;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, canvas.width, canvas.height);
            ctx.drawImage(img, 0, 0, w * s, h * s);
            canvas.toBlob(blob => { const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'mermaid-diagram.png'; a.click(); }, 'image/png');
          };
          img.src = 'data:image/svg+xml;base64,' + btoa(unescape(encodeURIComponent(svgData)));
        });
      });
    }, 1000);
  </script>
</head>
<body>
  <!-- 背景粒子效果 -->
  <canvas id="particles" class="particles-bg"></canvas>

  <div class="layout">
    <aside class="sidebar">
      <div class="sidebar-inner">
        <!-- 品牌区域 -->
        <div class="sidebar-brand">
          <div class="brand-glow"></div>
          <a href="/">学海无涯</a>
          <p class="brand-sub">ENDLESS LEARNING</p>
        </div>

        <!-- 导航 -->
        <nav class="sidebar-nav">
          <a href="/" class="nav-item">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span>首页</span>
          </a>
          <a href="/archive" class="nav-item">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="5" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>
            <span>归档</span>
          </a>
          <a href="/categories" class="nav-item">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            <span>分类</span>
          </a>
          <a href="/tags" class="nav-item">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            <span>标签</span>
          </a>
          <a href="/about" class="nav-item">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <span>关于</span>
          </a>
        </nav>

        <!-- 个人卡片 -->
        <div class="sidebar-profile">
          <div class="profile-avatar-ring">
            <img class="profile-avatar" src="https://p9-passport.byteacctimg.com/img/user-avatar/5b2b7b85d1c818fa71d9e2e8ba944a44~140x140.awebp" alt="头像" />
          </div>
          <div class="profile-name">张风捷特烈</div>
          <div class="profile-bio">Code is poetry</div>
          <div class="profile-links">
            <a href="https://github.com/toly1994328" target="_blank" rel="noopener" class="profile-link" aria-label="GitHub">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </a>
          </div>
        </div>

        <!-- 主题切换 -->
        <button id="theme-toggle" class="theme-toggle" aria-label="切换主题">
          <svg id="theme-icon-sun" class="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <svg id="theme-icon-moon" class="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <span id="theme-label">切换主题</span>
        </button>
      </div>
    </aside>

    <div class="main-wrapper">
      <main>
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-glow"></div>
        <p>© 2024 学海无涯 · Built with Astro</p>
      </footer>
    </div>
  </div>

  <script>
    // Theme toggle
    const toggle = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('theme-icon-sun') as HTMLElement;
    const moonIcon = document.getElementById('theme-icon-moon') as HTMLElement;
    const html = document.documentElement;
    const saved = localStorage.getItem('theme');

    function updateIcons() {
      const isLight = html.classList.contains('light');
      sunIcon.style.display = isLight ? 'block' : 'none';
      moonIcon.style.display = isLight ? 'none' : 'block';
    }

    // 默认亮色
    if (saved !== 'dark') {
      html.classList.add('light');
    }
    updateIcons();

    toggle?.addEventListener('click', () => {
      html.classList.toggle('light');
      const isLight = html.classList.contains('light');
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
      updateIcons();
    });

    // Particles background
    const canvas = document.getElementById('particles') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    let particles: {x:number;y:number;vx:number;vy:number;size:number;alpha:number}[] = [];

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }

    function initParticles() {
      particles = [];
      const count = Math.floor((canvas.width * canvas.height) / 15000);
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          vx: (Math.random() - 0.5) * 0.3,
          vy: (Math.random() - 0.5) * 0.3,
          size: Math.random() * 2 + 0.5,
          alpha: Math.random() * 0.5 + 0.1
        });
      }
    }

    function drawParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const isLight = html.classList.contains('light');
      
      particles.forEach(p => {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
        if (p.y < 0 || p.y > canvas.height) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
        ctx.fillStyle = isLight 
          ? `rgba(79, 70, 229, ${p.alpha * 0.3})` 
          : `rgba(129, 140, 248, ${p.alpha * 0.4})`;
        ctx.fill();
      });

      // Draw connections
      particles.forEach((a, i) => {
        particles.slice(i + 1).forEach(b => {
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < 120) {
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.strokeStyle = isLight
              ? `rgba(79, 70, 229, ${0.06 * (1 - dist / 120)})`
              : `rgba(129, 140, 248, ${0.08 * (1 - dist / 120)})`;
            ctx.stroke();
          }
        });
      });

      requestAnimationFrame(drawParticles);
    }

    resize();
    initParticles();
    drawParticles();
    window.addEventListener('resize', () => { resize(); initParticles(); });

    // Code block copy buttons
    document.querySelectorAll('.post-content pre').forEach(pre => {
      if (pre.querySelector('.mermaid')) return; // skip mermaid blocks
      pre.style.position = 'relative';
      const btn = document.createElement('button');
      btn.className = 'code-copy-btn';
      btn.title = '复制代码';
      btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      pre.appendChild(btn);
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code ? code.textContent : pre.textContent;
        await navigator.clipboard.writeText(text);
        btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
        setTimeout(() => {
          btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
        }, 2000);
      });
    });
  </script>
</body>
</html>

<style is:global>
  :root {
    --bg: #0a0a12;
    --bg-card: rgba(18, 18, 35, 0.6);
    --bg-sidebar: rgba(12, 12, 25, 0.65);
    --text: #e4e4e7;
    --text-muted: #9ca3af;
    --accent: #6366f1;
    --accent-light: #818cf8;
    --accent-glow: rgba(99, 102, 241, 0.3);
    --gradient-start: #6366f1;
    --gradient-mid: #a855f7;
    --gradient-end: #ec4899;
    --border: rgba(255, 255, 255, 0.08);
    --glass-blur: blur(20px);
    --glass-shine: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    --sidebar-width: 280px;
  }

  .light {
    --bg: #f0f2f8;
    --bg-card: rgba(255, 255, 255, 0.55);
    --bg-sidebar: rgba(255, 255, 255, 0.6);
    --text: #18181b;
    --text-muted: #6b7280;
    --accent: #4f46e5;
    --accent-light: #6366f1;
    --accent-glow: rgba(79, 70, 229, 0.15);
    --gradient-start: #4f46e5;
    --gradient-mid: #9333ea;
    --gradient-end: #db2777;
    --border: rgba(255, 255, 255, 0.5);
    --glass-blur: blur(16px);
    --glass-shine: inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Noto Sans SC', system-ui, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    min-height: 100vh;
    overflow-x: hidden;
  }

  a {
    color: var(--accent-light);
    text-decoration: none;
    transition: color 0.2s;
  }

  a:hover {
    color: var(--gradient-end);
  }

  /* Particles */
  .particles-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* Layout */
  .layout {
    position: relative;
    z-index: 1;
    display: flex;
    max-width: 1280px;
    margin: 0 auto;
    min-height: 100vh;
    padding: 2rem;
    gap: 2rem;
  }

  /* Sidebar */
  .sidebar {
    position: sticky;
    top: 2rem;
    width: var(--sidebar-width);
    height: calc(100vh - 4rem);
    flex-shrink: 0;
    z-index: 10;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem 1.5rem;
    background: var(--bg-sidebar);
    backdrop-filter: var(--glass-blur);
    -webkit-backdrop-filter: var(--glass-blur);
    border: 1px solid var(--border);
    border-radius: 20px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06), var(--glass-shine);
  }

  .sidebar-brand {
    text-align: center;
    margin-bottom: 2rem;
    position: relative;
  }

  .brand-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 120px;
    height: 120px;
    background: radial-gradient(circle, var(--accent-glow), transparent);
    border-radius: 50%;
    filter: blur(20px);
    pointer-events: none;
  }

  .sidebar-brand a {
    position: relative;
    font-size: 1.7rem;
    font-weight: 900;
    background: linear-gradient(135deg, var(--gradient-start), var(--gradient-mid), var(--gradient-end));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
  }

  .brand-sub {
    font-family: 'Orbitron', monospace;
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.2em;
    margin-top: 0.25rem;
    opacity: 0.7;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 1.5rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 1rem;
    border-radius: 12px;
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.9rem;
    transition: all 0.25s ease;
    position: relative;
    overflow: hidden;
  }

  .nav-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02));
    opacity: 0;
    transition: opacity 0.25s;
    border-radius: 12px;
  }

  .nav-item:hover::before {
    opacity: 1;
  }

  .nav-item:hover {
    color: var(--text);
    transform: translateX(4px);
    box-shadow: 0 2px 12px var(--accent-glow);
  }

  .nav-item span {
    position: relative;
    z-index: 1;
  }

  .nav-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .theme-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Profile */
  .sidebar-profile {
    text-align: center;
    padding: 1.5rem 0;
    margin-bottom: 1rem;
  }

  .profile-avatar-ring {
    width: 80px;
    height: 80px;
    margin: 0 auto 0.75rem;
    border-radius: 50%;
